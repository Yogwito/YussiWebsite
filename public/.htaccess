# Generado por scripts/build-htaccess.mjs desde vercel.json. No editar a mano.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Archivos y carpetas ocultos (.DS_Store, .git, .env…): prohibidos, salvo .well-known (AutoSSL)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]

  # HTTPS y www → raíz en un solo salto
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://bordadosyussi.com%{REQUEST_URI} [L,R=301]

  # Sitio viejo
  RewriteRule ^quienes-somos/?$ /#about [NE,L,R=301]
  RewriteRule ^nuestros-servicios/?$ /#services [NE,L,R=301]
  RewriteRule ^precios/?$ /#contact [NE,L,R=301]
  RewriteRule ^contacta-con-nosotros/?$ /#contact [NE,L,R=301]

  # Medios renombrados (147 reglas de vercel.json)
  RewriteRule ^apple-touch-icon\.png$ /media/brand/apple-touch-icon.png [L,R=301]
  RewriteRule ^favicon-16\.png$ /media/brand/favicon-16.png [L,R=301]
  RewriteRule ^favicon-32\.png$ /media/brand/favicon-32.png [L,R=301]
  RewriteRule ^img/og-cover\.jpg$ /media/brand/og-cover.jpg [L,R=301]
  RewriteRule ^img/yussi-logo-nav\.png$ /media/brand/yussi-logo.png [L,R=301]
